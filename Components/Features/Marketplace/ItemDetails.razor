<a class="back" href="/"><img src="images/figma/74620.svg" alt="" />Back to Marketplace</a>
<div class="item-layout">
    <div class="gallery"><div class="main-photo"><img class="@(zoomed ? "zoomed" : "")" src="@Item.Image" alt="@Item.Title" /><span>@Item.Condition</span></div><div class="thumbnails"><button class="@(!zoomed ? "chosen" : "")" aria-label="Full product photo" aria-pressed="@(!zoomed)" @onclick="() => zoomed = false"><img src="@Item.Image" alt="" /></button><button class="@(zoomed ? "chosen" : "")" aria-label="Closer product photo" aria-pressed="@zoomed" @onclick="() => zoomed = true"><img class="zoomed" src="@Item.Image" alt="" /></button><small>Take a closer look.</small></div></div>
    <div class="info"><div class="category-row"><span>@Item.Category</span><span class="available">● @(Item.Sold ? "Sold" : "Available")</span></div><h1>@Item.Title</h1><div class="price"><strong>₱@Item.Price.ToString("N0")</strong><small>A student-friendly find.</small></div><section class="description"><h2>A little about this item</h2><p>@Item.Description</p></section><div class="seller-box"><span class="avatar">@Item.Initials</span><div><b>@Item.Seller</b><small>@(Item.Id == 1 ? "BS Engineering · 2nd year" : "Campus community member")</small><small>Luntian University · Quezon City</small></div><img src="images/figma/8f1d9.svg" alt="Verified student" /></div><div class="meetup"><img src="images/figma/aa797.svg" alt="" /><div><small>Preferred meetup spot</small><p>@Item.Location@(Item.Id == 1 ? " entrance" : "")</p></div></div><button class="button primary contact" disabled="@Item.Sold" @onclick="() => contact = !contact"><img src="images/figma/c601c.svg" alt="" />Contact Seller</button>@if(contact) { <p class="contact-note" role="status">This is a frontend demo. Seller messaging isn’t connected yet.</p> }<p class="safety"><img src="images/figma/06854.svg" alt="" />Meet on campus. Check the item. Keep it simple.</p></div>
</div>
@code {
    [Parameter, EditorRequired] public Listing Item { get; set; } = default!;
    private bool zoomed, contact;
}
